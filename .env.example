# Supabase project grid-prof (Settings > API Keys). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by Server Actions after the role check. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Sign-in providers to offer, comma-separated: google, azure. Each must be configured in Supabase first.
NEXT_PUBLIC_AUTH_PROVIDERS=
